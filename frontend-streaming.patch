+import { memo } from 'react';
+import ReactMarkdown from 'react-markdown';
+import remarkGfm from 'remark-gfm';
+import { Box } from '@chakra-ui/react';
+
+interface MarkdownContentProps {
+  content: string;
+  className?: string;
+}
+
+export const MarkdownContent = memo(({ content, className }: MarkdownContentProps) => (
+  <Box className={`llm-markdown${className ? ` ${className}` : ''}`}>
+    <ReactMarkdown
+      remarkPlugins={[remarkGfm]}
+      components={{
+        a: ({ href, children }) => (
+          <a href={href} target="_blank" rel="noreferrer noopener">
+            {children}
+          </a>
+        ),
+      }}
+    >
+      {content}
+    </ReactMarkdown>
+  </Box>
+));
+
+MarkdownContent.displayName = 'MarkdownContent';
diff --git a/src/renderer/src/components/sidebar/rich-message-content.tsx b/src/renderer/src/components/sidebar/rich-message-content.tsx
new file mode 100644
index 0000000..18e8598
--- /dev/null
+++ b/src/renderer/src/components/sidebar/rich-message-content.tsx
@@ -0,0 +1,115 @@
+import { useMemo } from 'react';
+import {
+  Box, Flex, Icon, Spinner, Text,
+} from '@chakra-ui/react';
+import {
+  FaBrain, FaRunning, FaSmile,
+} from 'react-icons/fa';
+import type { ModelInfo } from '@/context/live2d-config-context';
+import {
+  parseMessageContent,
+  type ActionTag,
+  type ThinkBlock as ThinkBlockData,
+} from '@/utils/rich-text';
+import { MarkdownContent } from './markdown-content';
+import { CollapsibleBlock } from './collapsible-block';
+
+interface RichMessageContentProps {
+  content: string;
+  modelInfo?: ModelInfo;
+  parseTags?: boolean;
+}
+
+function ThinkBlock({ block }: { block: ThinkBlockData }) {
+  return (
+    <CollapsibleBlock
+      className="llm-think-block"
+      summary={(
+        <>
+          <Icon as={FaBrain} boxSize="12px" color="purple.300" />
+          <Text as="span" fontSize="xs" color="whiteAlpha.700">
+            {block.closed ? '思考过程' : '思考中...'}
+          </Text>
+          {!block.closed && <Spinner size="xs" color="purple.300" />}
+        </>
+      )}
+    >
+      {block.text.trim() ? (
+        <MarkdownContent content={block.text} />
+      ) : (
+        <Text fontSize="xs" color="whiteAlpha.500">
+          （空）
+        </Text>
+      )}
+    </CollapsibleBlock>
+  );
+}
+
+function ActionBlock({ actions }: { actions: ActionTag[] }) {
+  return (
+    <Box className="llm-action-block">
+      <Text fontSize="xs" color="whiteAlpha.500" mb="4px">
+        Live2D 动作
+      </Text>
+      <Flex wrap="wrap" gap="6px">
+        {actions.map((action, index) => {
+          const isExpression = action.kind === 'expression';
+          return (
+            <Flex
+              key={`${action.kind}-${action.name}-${index}`}
+              align="center"
+              gap="4px"
+              px="8px"
+              py="2px"
+              borderRadius="full"
+              bg={isExpression ? 'purple.900' : 'blue.900'}
+              color={isExpression ? 'purple.100' : 'blue.100'}
+              border="1px solid"
+              borderColor={isExpression ? 'purple.700' : 'blue.700'}
+              title={isExpression ? '表情' : '动作'}
+            >
+              <Icon
+                as={isExpression ? FaSmile : FaRunning}
+                boxSize="10px"
+              />
+              <Text fontSize="xs">{action.name}</Text>
+            </Flex>
+          );
+        })}
+      </Flex>
+    </Box>
+  );
+}
+
+export function RichMessageContent({
+  content,
+  modelInfo,
+  parseTags = true,
+}: RichMessageContentProps) {
+  const parsed = useMemo(() => {
+    if (!parseTags) {
+      return {
+        blocks: [{ type: 'text' as const, text: content }],
+        actions: [] as ActionTag[],
+      };
+    }
+    return parseMessageContent(content, modelInfo);
+  }, [content, modelInfo, parseTags]);
+
+  if (parsed.blocks.length === 0 && parsed.actions.length === 0) {
+    return null;
+  }
+
+  return (
+    <Box className="llm-rich-content">
+      {parsed.blocks.map((block, index) => (
+        block.type === 'think' ? (
+          <ThinkBlock key={`think-${index}`} block={block} />
+        ) : (
+          <MarkdownContent key={`text-${index}`} content={block.text} />
+        )
+      ))}
+      {parsed.actions.length > 0 && <ActionBlock actions={parsed.actions} />}
+    </Box>
+  );
+}
