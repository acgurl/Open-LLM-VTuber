+++ b/src/renderer/src/components/sidebar/collapsible-block.tsx
@@ -0,0 +1,41 @@
+import type { ReactNode } from 'react';
+import {
+  Box, Flex, Icon, type BoxProps,
+} from '@chakra-ui/react';
+import { FaChevronRight } from 'react-icons/fa';
+
+interface CollapsibleBlockProps {
+  className: string;
+  summary: ReactNode;
+  summaryGap?: string;
+  containerProps?: BoxProps;
+  children: ReactNode;
+}
+
+export function CollapsibleBlock({
+  className,
+  summary,
+  summaryGap = '6px',
+  containerProps,
+  children,
+}: CollapsibleBlockProps) {
+  return (
+    <Box as="details" className={className} {...containerProps}>
+      <Box as="summary" className="llm-collapsible-summary">
+        <Flex align="center" gap={summaryGap}>
+          {summary}
+          <Icon
+            as={FaChevronRight}
+            boxSize="10px"
+            color="whiteAlpha.500"
+            ml="auto"
+            className="llm-chevron"
+          />
+        </Flex>
+      </Box>
+      <Box className="llm-collapsible-body">
+        {children}
+      </Box>
+    </Box>
+  );
+}
