diff --git a/src/renderer/src/utils/rich-text.ts b/src/renderer/src/utils/rich-text.ts
new file mode 100644
index 0000000..a745948
--- /dev/null
+++ b/src/renderer/src/utils/rich-text.ts
@@ -0,0 +1,228 @@
+import type { ModelInfo } from '@/context/live2d-config-context';
+
+export type ActionKind = 'expression' | 'motion';
+
+export interface ActionTag {
+  kind: ActionKind;
+  name: string;
+}
+
+export interface TextBlock {
+  type: 'text';
+  text: string;
+}
+
+export interface ThinkBlock {
+  type: 'think';
+  text: string;
+  closed: boolean;
+}
+
+export type MessageBlock = TextBlock | ThinkBlock;
+
+export interface ParsedMessage {
+  blocks: MessageBlock[];
+  actions: ActionTag[];
+}
+
+const THINK_START = '<think>';
+const THINK_END = '</think>';
+
+function trimIncompleteThinkTag(text: string): string {
+  const tail = text.match(/<[^<>]*$/);
+  if (!tail) return text;
+
+  const prefix = tail[0].toLowerCase();
+  if (THINK_START.startsWith(prefix) || THINK_END.startsWith(prefix)) {
+    return text.slice(0, -tail[0].length);
+  }
+  return text;
+}
+
+function sanitizeText(text: string): string {
+  return text.replace(/<\/think>/gi, '').replace(/<think\/>/gi, '');
+}
+
+function splitThinkBlocks(text: string): MessageBlock[] {
+  const blocks: MessageBlock[] = [];
+  const lower = text.toLowerCase();
+  let cursor = 0;
+
+  while (cursor < text.length) {
+    const start = lower.indexOf(THINK_START, cursor);
+    if (start === -1) {
+      const tail = trimIncompleteThinkTag(text.slice(cursor));
+      if (tail) blocks.push({ type: 'text', text: sanitizeText(tail) });
+      break;
+    }
+
+    if (start > cursor) {
+      blocks.push({
+        type: 'text',
+        text: sanitizeText(text.slice(cursor, start)),
+      });
+    }
+
+    const contentStart = start + THINK_START.length;
+    const end = lower.indexOf(THINK_END, contentStart);
+    if (end === -1) {
+      blocks.push({
+        type: 'think',
+        text: trimIncompleteThinkTag(text.slice(contentStart)),
+        closed: false,
+      });
+      break;
+    }
+
+    blocks.push({
+      type: 'think',
+      text: text.slice(contentStart, end),
+      closed: true,
+    });
+    cursor = end + THINK_END.length;
+  }
+
+  return blocks;
+}
+
+interface ActionLookup {
+  expressions: Set<string>;
+  motions: Set<string>;
+}
+
+function buildActionLookup(modelInfo?: ModelInfo): ActionLookup {
+  return {
+    expressions: new Set(
+      Object.keys(modelInfo?.emotionMap || {}).map((key) => key.toLowerCase()),
+    ),
+    motions: new Set(
+      Object.keys(modelInfo?.motionMap || {}).map((key) => key.toLowerCase()),
+    ),
+  };
+}
+
+function isActionPrefix(value: string, lookup: ActionLookup): boolean {
+  const lower = value.toLowerCase();
+  return [...lookup.expressions, ...lookup.motions].some((key) => key.startsWith(lower));
+}
+
+function extractActions(
+  text: string,
+  lookup: ActionLookup,
+): { text: string; actions: ActionTag[] } {
+  if (lookup.expressions.size === 0 && lookup.motions.size === 0) {
+    return { text, actions: [] };
+  }
+
+  const actions: ActionTag[] = [];
+  let cleaned = text.replace(/\[([^\]\n]{1,64})\]/g, (match, rawKey: string) => {
+    const key = rawKey.trim().toLowerCase();
+    if (lookup.expressions.has(key)) {
+      actions.push({ kind: 'expression', name: rawKey.trim() });
+      return '';
+    }
+    if (lookup.motions.has(key)) {
+      actions.push({ kind: 'motion', name: rawKey.trim() });
+      return '';
+    }
+    return match;
+  });
+
+  // Hide a partial tag like "[jo" while tokens are still arriving.
+  const tail = cleaned.match(/\[([^\]\n]*)$/);
+  if (tail) {
+    const prefix = tail[1].trim();
+    if (!prefix || isActionPrefix(prefix, lookup)) {
+      cleaned = cleaned.slice(0, -tail[0].length);
+    }
+  }
+
+  return { text: cleaned, actions };
+}
+
+export function parseMessageContent(
+  raw: string,
+  modelInfo?: ModelInfo,
+): ParsedMessage {
+  const lookup = buildActionLookup(modelInfo);
+  const actions: ActionTag[] = [];
+  const blocks: MessageBlock[] = [];
+
+  for (const block of splitThinkBlocks(raw || '')) {
+    if (block.type === 'think') {
+      const extracted = extractActions(block.text, lookup);
+      actions.push(...extracted.actions);
+      blocks.push({ ...block, text: extracted.text });
+      continue;
+    }
+
+    const extracted = extractActions(block.text, lookup);
+    actions.push(...extracted.actions);
+    if (extracted.text.trim()) {
+      blocks.push({ type: 'text', text: extracted.text });
+    }
+  }
+
+  const seen = new Set<string>();
+  return {
+    blocks,
+    actions: actions.filter((action) => {
+      const key = `${action.kind}:${action.name.toLowerCase()}`;
+      if (seen.has(key)) return false;
+      seen.add(key);
+      return true;
+    }),
+  };
+}
+
+export function stripRichText(raw: string, modelInfo?: ModelInfo): string {
+  const { blocks } = parseMessageContent(raw, modelInfo);
+  return blocks
+    .filter((block): block is TextBlock => block.type === 'text')
+    .map((block) => block.text)
+    .join(' ')
+    .trim();
+}
+
+function markdownToPlainText(markdown: string): string {
+  return markdown
+    .replace(/```[a-zA-Z0-9_-]*\s*\n?/g, '')
+    .replace(/`([^`\n]+)`/g, '$1')
+    .replace(/!\[([^\]]*)\]\([^)]*\)/g, '$1')
+    .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
+    .replace(/(\*\*|__)(.*?)\1/g, '$2')
+    .replace(/\*([^*\n]+)\*/g, '$1')
+    .replace(/_([^_\n]+)_/g, '$1')
+    .replace(/^#{1,6}\s+/gm, '')
+    .replace(/^\s*>\s?/gm, '')
+    .replace(/^\s*(?:[-*+]|\d+\.)\s+/gm, '')
+    .replace(/^\s*[-*_]{3,}\s*$/gm, '')
+    .replace(/\|/g, ' ')
+    .replace(/\s+/g, ' ')
+    .trim();
+}
+
+export function toPlainSubtitle(raw: string, modelInfo?: ModelInfo): string {
+  return markdownToPlainText(stripRichText(raw, modelInfo));
+}
+
+export function toSubtitleLineFromPlain(plain: string): string {
+  if (!plain) return '';
+
+  const parts = plain.split(/([。！？!?])/);
+  const sentences: string[] = [];
+  for (let index = 0; index < parts.length; index += 2) {
+    const sentence = `${parts[index] || ''}${parts[index + 1] || ''}`.trim();
+    if (sentence) sentences.push(sentence);
+  }
+
+  return sentences[sentences.length - 1] || plain;
+}
+
+export function toSubtitleAtProgress(plain: string, ratio: number): string {
+  if (!plain) return '';
+
+  const clamped = Math.max(0, Math.min(1, ratio));
+  const visibleCount = Math.max(1, Math.ceil(plain.length * clamped));
+  return toSubtitleLineFromPlain(plain.slice(0, visibleCount));
+}
