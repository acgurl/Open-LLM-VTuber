diff --git a/src/renderer/src/utils/lip-sync.ts b/src/renderer/src/utils/lip-sync.ts
new file mode 100644
index 0000000..b719f87
--- /dev/null
+++ b/src/renderer/src/utils/lip-sync.ts
@@ -0,0 +1,150 @@
+export type Live2DModel = any;
+
+export interface WavFileHandler {
+  _ownerModel: Live2DModel;
+  _syncAudio: HTMLAudioElement | null;
+  _volumes: number[] | null;
+  _sliceLength: number;
+  _lipSyncGain: number;
+  _initialized?: boolean;
+  _lastRms: number;
+  _sampleOffset: number;
+  _userTimeSeconds: number;
+  _wavFileInfo: { _samplingRate: number };
+  update: (deltaTimeSeconds: number) => boolean;
+  start: (filePath: string) => Promise<boolean>;
+  releasePcmData?: () => void;
+}
+
+interface LipSyncInstallation {
+  wavHandler: WavFileHandler | null;
+  hasVolumeSchedule: boolean;
+}
+
+const DEFAULT_LIP_SYNC_GAIN = 0.2;
+
+export function resolveLipSyncGain(modelInfo?: { lipSyncGain?: number }): number {
+  const configuredGain = modelInfo?.lipSyncGain;
+  return typeof configuredGain === 'number'
+    && Number.isFinite(configuredGain)
+    && configuredGain >= 0
+    ? configuredGain
+    : DEFAULT_LIP_SYNC_GAIN;
+}
+
+/**
+ * Drive the mouth from the backend's per-slice RMS envelope. This keeps lip
+ * sync independent of the async WAV decode, which can otherwise leave a later
+ * sentence without a waveform.
+ */
+export function installLipSyncDriver({
+  model,
+  audio,
+  volumes,
+  sliceLength,
+  lipSyncGain,
+  getCurrentAudio,
+}: {
+  model: Live2DModel;
+  audio: HTMLAudioElement;
+  volumes: number[];
+  sliceLength: number;
+  lipSyncGain: number;
+  getCurrentAudio: () => HTMLAudioElement | null;
+}): LipSyncInstallation {
+  const hasVolumeSchedule = Array.isArray(volumes)
+    && volumes.length > 0
+    && sliceLength > 0;
+  const wavHandler = model._wavFileHandler as WavFileHandler | undefined;
+  if (!wavHandler) {
+    return { wavHandler: null, hasVolumeSchedule };
+  }
+
+  wavHandler._ownerModel = model;
+  wavHandler._syncAudio = audio;
+  wavHandler._volumes = hasVolumeSchedule ? volumes : null;
+  wavHandler._sliceLength = sliceLength;
+  wavHandler._lipSyncGain = lipSyncGain;
+
+  if (!wavHandler._initialized) {
+    console.log('Applying audio-driven lip sync');
+    wavHandler._initialized = true;
+
+    const originalUpdate = wavHandler.update.bind(wavHandler);
+    wavHandler.update = function (this: WavFileHandler, deltaTimeSeconds: number) {
+      const activeAudio = getCurrentAudio();
+      const isActive = !!activeAudio
+        && activeAudio === this._syncAudio
+        && !activeAudio.paused
+        && !activeAudio.ended
+        && activeAudio.currentTime > 0;
+
+      if (!isActive) {
+        this._lastRms = 0;
+        return false;
+      }
+
+      // Idle/Talk motions also animate the mouth parameter. Clear their
+      // value while speaking so only the audio amplitude drives the mouth.
+      const ownerModel = this._ownerModel;
+      const lipSyncIds = ownerModel?._lipSyncIds;
+      if (lipSyncIds && ownerModel?._model) {
+        for (let i = 0; i < lipSyncIds.getSize(); i++) {
+          ownerModel._model.setParameterValueById(lipSyncIds.at(i), 0);
+        }
+      }
+
+      if (this._volumes && this._sliceLength > 0) {
+        const position = (activeAudio.currentTime * 1000) / this._sliceLength;
+        const lower = Math.floor(position);
+        if (lower >= this._volumes.length) {
+          this._lastRms = 0;
+          return true;
+        }
+        const fraction = position - lower;
+        const v0 = this._volumes[lower] ?? 0;
+        const v1 = this._volumes[Math.min(lower + 1, this._volumes.length - 1)] ?? v0;
+        const volume = v0 + (v1 - v0) * fraction;
+        this._lastRms = volume * (this._lipSyncGain ?? DEFAULT_LIP_SYNC_GAIN);
+        return true;
+      }
+
+      // Fallback for payloads without a volume schedule. Anchor the PCM
+      // cursor to the audio clock rather than the handler's own timer.
+      this._userTimeSeconds = Math.max(0, activeAudio.currentTime - deltaTimeSeconds);
+      const samplingRate = this._wavFileInfo?._samplingRate ?? 0;
+      if (samplingRate > 0) {
+        const goalOffset = Math.floor(this._userTimeSeconds * samplingRate);
+        if (goalOffset <= this._sampleOffset) {
+          return false;
+        }
+      }
+      return originalUpdate(deltaTimeSeconds);
+    };
+  }
+
+  return { wavHandler, hasVolumeSchedule };
+}
+
+export function resetLipSync(model: Live2DModel | null): void {
+  if (model?._wavFileHandler) {
+    try {
+      const wavHandler = model._wavFileHandler as WavFileHandler;
+      // Release PCM data to stop lip sync calculation in update()
+      wavHandler.releasePcmData?.();
+      console.log('[AudioManager] Called _wavFileHandler.releasePcmData()');
+
+      // Additional reset of state variables as fallback
+      wavHandler._lastRms = 0;
+      wavHandler._sampleOffset = 0;
+      wavHandler._userTimeSeconds = 0;
+      console.log('[AudioManager] Also reset _lastRms, _sampleOffset, _userTimeSeconds as fallback');
+    } catch (e) {
+      console.error('[AudioManager] Error stopping/resetting wavFileHandler:', e);
+    }
+  } else if (model) {
+    console.warn('[AudioManager] Current model does not have _wavFileHandler to stop/reset.');
+  } else {
+    console.log('[AudioManager] No associated model found to stop lip sync.');
+  }
+}
diff --git a/src/renderer/src/utils/rich-text.ts b/src/renderer/src/utils/rich-text.ts
new file mode 100644
index 0000000..ff4bc4e
--- /dev/null
+++ b/src/renderer/src/utils/rich-text.ts
@@ -0,0 +1,228 @@
+import type { ModelInfo } from '@/context/live2d-config-context';
+
+export type ActionKind = 'expression' | 'motion';
+
+export interface ActionTag {
+  kind: ActionKind;
+  name: string;
+}
+
+export interface TextBlock {
+  type: 'text';
+  text: string;
+}
+
+export interface ThinkBlock {
+  type: 'think';
+  text: string;
+  closed: boolean;
+}
+
+export type MessageBlock = TextBlock | ThinkBlock;
+
+export interface ParsedMessage {
+  blocks: MessageBlock[];
+  actions: ActionTag[];
+}
+
+const THINK_START = '<think>';
+const THINK_END = '</think>';
+
+function trimIncompleteThinkTag(text: string): string {
+  const tail = text.match(/<[^<>]*$/);
+  if (!tail) return text;
+
+  const prefix = tail[0].toLowerCase();
+  if (THINK_START.startsWith(prefix) || THINK_END.startsWith(prefix)) {
+    return text.slice(0, -tail[0].length);
+  }
+  return text;
+}
+
+function sanitizeText(text: string): string {
+  return text.replace(/<\/think>/gi, '').replace(/<think\/>/gi, '');
+}
+
+function splitThinkBlocks(text: string): MessageBlock[] {
+  const blocks: MessageBlock[] = [];
+  const lower = text.toLowerCase();
+  let cursor = 0;
+
+  while (cursor < text.length) {
+    const start = lower.indexOf(THINK_START, cursor);
+    if (start === -1) {
+      const tail = trimIncompleteThinkTag(text.slice(cursor));
+      if (tail) blocks.push({ type: 'text', text: sanitizeText(tail) });
+      break;
+    }
+
+    if (start > cursor) {
+      blocks.push({
+        type: 'text',
+        text: sanitizeText(text.slice(cursor, start)),
+      });
+    }
+
+    const contentStart = start + THINK_START.length;
+    const end = lower.indexOf(THINK_END, contentStart);
+    if (end === -1) {
+      blocks.push({
+        type: 'think',
+        text: trimIncompleteThinkTag(text.slice(contentStart)),
+        closed: false,
+      });
+      break;
+    }
+
+    blocks.push({
+      type: 'think',
+      text: text.slice(contentStart, end),
+      closed: true,
+    });
+    cursor = end + THINK_END.length;
+  }
+
+  return blocks;
+}
+
+interface ActionLookup {
+  expressions: Set<string>;
+  motions: Set<string>;
+  allKeys: string[];
+}
+
+function buildActionLookup(modelInfo?: ModelInfo): ActionLookup {
+  const expressions = new Set(
+    Object.keys(modelInfo?.emotionMap || {}).map((key) => key.toLowerCase()),
+  );
+  const motions = new Set(
+    Object.keys(modelInfo?.motionMap || {}).map((key) => key.toLowerCase()),
+  );
+  return {
+    expressions,
+    motions,
+    allKeys: [...expressions, ...motions],
+  };
+}
+
+function isActionPrefix(value: string, lookup: ActionLookup): boolean {
+  const lower = value.toLowerCase();
+  return lookup.allKeys.some((key) => key.startsWith(lower));
+}
+
+function extractActions(
+  text: string,
+  lookup: ActionLookup,
+): { text: string; actions: ActionTag[] } {
+  if (lookup.expressions.size === 0 && lookup.motions.size === 0) {
+    return { text, actions: [] };
+  }
+
+  const actions: ActionTag[] = [];
+  let cleaned = text.replace(/\[([^\]\n]{1,64})\]/g, (match, rawKey: string) => {
+    const key = rawKey.trim().toLowerCase();
+    if (lookup.expressions.has(key)) {
+      actions.push({ kind: 'expression', name: rawKey.trim() });
+      return '';
+    }
+    if (lookup.motions.has(key)) {
+      actions.push({ kind: 'motion', name: rawKey.trim() });
+      return '';
+    }
+    return match;
+  });
+
+  // Hide a partial tag like "[jo" while tokens are still arriving.
+  const tail = cleaned.match(/\[([^\]\n]*)$/);
+  if (tail) {
+    const prefix = tail[1].trim();
+    if (!prefix || isActionPrefix(prefix, lookup)) {
+      cleaned = cleaned.slice(0, -tail[0].length);
+    }
+  }
+
+  return { text: cleaned, actions };
+}
+
+export function parseMessageContent(
+  raw: string,
+  modelInfo?: ModelInfo,
+): ParsedMessage {
+  const lookup = buildActionLookup(modelInfo);
+  const actions: ActionTag[] = [];
+  const blocks: MessageBlock[] = [];
+
+  for (const block of splitThinkBlocks(raw || '')) {
+    const extracted = extractActions(block.text, lookup);
+    actions.push(...extracted.actions);
+
+    if (block.type === 'think') {
+      blocks.push({ ...block, text: extracted.text });
+    } else if (extracted.text.trim()) {
+      blocks.push({ type: 'text', text: extracted.text });
+    }
+  }
+
+  const seen = new Set<string>();
+  return {
+    blocks,
+    actions: actions.filter((action) => {
+      const key = `${action.kind}:${action.name.toLowerCase()}`;
+      if (seen.has(key)) return false;
+      seen.add(key);
+      return true;
+    }),
+  };
+}
+
+export function stripRichText(raw: string, modelInfo?: ModelInfo): string {
+  const { blocks } = parseMessageContent(raw, modelInfo);
+  return blocks
+    .filter((block): block is TextBlock => block.type === 'text')
+    .map((block) => block.text)
+    .join(' ')
+    .trim();
+}
+
+function markdownToPlainText(markdown: string): string {
+  return markdown
+    .replace(/```[a-zA-Z0-9_-]*\s*\n?/g, '')
+    .replace(/`([^`\n]+)`/g, '$1')
+    .replace(/!\[([^\]]*)\]\([^)]*\)/g, '$1')
+    .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
+    .replace(/(\*\*|__)(.*?)\1/g, '$2')
+    .replace(/\*([^*\n]+)\*/g, '$1')
+    .replace(/_([^_\n]+)_/g, '$1')
+    .replace(/^#{1,6}\s+/gm, '')
+    .replace(/^\s*>\s?/gm, '')
+    .replace(/^\s*(?:[-*+]|\d+\.)\s+/gm, '')
+    .replace(/^\s*[-*_]{3,}\s*$/gm, '')
+    .replace(/\|/g, ' ')
+    .replace(/\s+/g, ' ')
+    .trim();
+}
+
+export function toPlainSubtitle(raw: string, modelInfo?: ModelInfo): string {
+  return markdownToPlainText(stripRichText(raw, modelInfo));
+}
+
+export function toSubtitleLineFromPlain(plain: string): string {
+  if (!plain) return '';
+
+  const parts = plain.split(/([。！？!?])/);
+  const sentences: string[] = [];
+  for (let index = 0; index < parts.length; index += 2) {
+    const sentence = `${parts[index] || ''}${parts[index + 1] || ''}`.trim();
+    if (sentence) sentences.push(sentence);
+  }
+
+  return sentences[sentences.length - 1] || plain;
+}
+
+export function toSubtitleAtProgress(plain: string, ratio: number): string {
+  if (!plain) return '';
+
+  const clamped = Math.max(0, Math.min(1, ratio));
+  const visibleCount = Math.max(1, Math.ceil(plain.length * clamped));
+  return toSubtitleLineFromPlain(plain.slice(0, visibleCount));
+}
